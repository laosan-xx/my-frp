#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

NAME=frpc
PROG=/usr/bin/$NAME

_err() {
	echo "$*" >&2
	logger -p daemon.err -t "$NAME" "$*"
}

# Format value for TOML output (quote strings, leave numbers/booleans bare)
toml_value() {
	local val="$1"
	case "$val" in
		true|false) printf '%s' "$val" ;;
		*[!0-9-]*) printf '"%s"' "$val" ;;
		*) printf '%s' "$val" ;;
	esac
}

# Map old INI-style keys to new TOML keys for client common section
map_common_key() {
	case "$1" in
		server_addr)        echo "serverAddr" ;;
		server_port)        echo "serverPort" ;;
		token)              echo "auth.token" ;;
		auth_method)        echo "auth.method" ;;
		user)               echo "user" ;;
		client_id)          echo "clientID" ;;
		login_fail_exit)    echo "loginFailExit" ;;
		protocol)           echo "transport.protocol" ;;
		wire_protocol)      echo "transport.wireProtocol" ;;
		tls_enable)         echo "transport.tls.enable" ;;
		pool_count)         echo "transport.poolCount" ;;
		tcp_mux)            echo "transport.tcpMux" ;;
		heartbeat_interval) echo "transport.heartbeatInterval" ;;
		heartbeat_timeout)  echo "transport.heartbeatTimeout" ;;
		dial_server_timeout) echo "transport.dialServerTimeout" ;;
		dial_server_keepalive) echo "transport.dialServerKeepalive" ;;
		connect_server_local_ip) echo "transport.connectServerLocalIP" ;;
		proxy_url)          echo "transport.proxyURL" ;;
		dns_server)         echo "dnsServer" ;;
		udp_packet_size)    echo "udpPacketSize" ;;
		*)                  echo "$1" ;;
	esac
}

# Map old INI-style keys to new TOML keys for proxy sections
map_proxy_key() {
	case "$1" in
		type)                    echo "type" ;;
		local_ip)                echo "localIP" ;;
		local_port)              echo "localPort" ;;
		remote_port)             echo "remotePort" ;;
		use_encryption)          echo "transport.useEncryption" ;;
		use_compression)         echo "transport.useCompression" ;;
		bandwidth_limit)         echo "transport.bandwidthLimit" ;;
		bandwidth_limit_mode)    echo "transport.bandwidthLimitMode" ;;
		custom_domains)          echo "customDomains" ;;
		subdomain)               echo "subdomain" ;;
		group)                   echo "loadBalancer.group" ;;
		group_key)               echo "loadBalancer.groupKey" ;;
		health_check_type)       echo "healthCheck.type" ;;
		health_check_timeout)    echo "healthCheck.timeoutSeconds" ;;
		health_check_max_failed) echo "healthCheck.maxFailed" ;;
		health_check_interval)   echo "healthCheck.intervalSeconds" ;;
		secret_key)              echo "secretKey" ;;
		allow_users)             echo "allowUsers" ;;
		*)                       echo "$1" ;;
	esac
}

# Keys that require TOML array value
is_array_key() {
	case "$1" in
		customDomains|allowUsers) return 0 ;;
		*) return 1 ;;
	esac
}

config_cb() {
	[ $# -eq 0 ] && return

	local type="$1"
	local name="$2"
	if [ "$type" = "conf" ]; then
		if [ "$name" = "common" ]; then
			# Common section: top-level TOML keys
			option_cb() {
				local option="$1"
				local value="$2"
				local key=$(map_common_key "$option")
				echo "$key = $(toml_value "$value")" >> "$conf_file"
			}
		else
			# Proxy section: [[proxies]] array of tables
			echo "" >> "$conf_file"
			echo "[[proxies]]" >> "$conf_file"
			echo "name = \"$name\"" >> "$conf_file"
			option_cb() {
				local option="$1"
				local value="$2"
				[ "$option" = "name" ] && return 0
				local key=$(map_proxy_key "$option")
				if is_array_key "$key"; then
					echo "$key = [\"$value\"]" >> "$conf_file"
				else
					echo "$key = $(toml_value "$value")" >> "$conf_file"
				fi
			}
		fi
		list_cb() {
			local name="$1"
			local value="$2"
			[ "$name" = "_" ] && echo "$value" >> "$conf_file"
		}
	else
		[ "$type" = "init" ] && init_cfg="$name"
		option_cb() { return 0; }
		list_cb() { return 0; }
	fi
}

service_triggers()
{
	procd_add_reload_trigger "$NAME"
}

generate_random_user() {
	local pkg="frpc"
	local section="common"
	local current_val
	
	current_val=$(uci -q get ${pkg}.${section}.user)

	if [ "$current_val" = "0000" ] || [ -z "$current_val" ]; then
		local new_id new_id_lower
		new_id=$(head -c 64 /dev/urandom | tr -dc 'a-zA-Z' | head -c 8)
		# custom_domains 需要全小写
		new_id_lower=$(echo "$new_id" | tr 'A-Z' 'a-z')
		
		uci set ${pkg}.${section}.user="$new_id"
		uci set ${pkg}.${section}.client_id="$new_id"

		# 同步修改 WEB 段 custom_domains 中的 0000（使用小写 ID）
		local web_domain
		web_domain=$(uci -q get ${pkg}.WEB.custom_domains)
		if [ -n "$web_domain" ]; then
			uci set ${pkg}.WEB.custom_domains="$(echo "$web_domain" | sed "s/0000/$new_id_lower/g")"
		fi

		uci commit ${pkg}
		# 强制同步文件到磁盘
		sync
		logger -t frpc "Config updated to $new_id, syncing to disk..."
	fi
}

start_service() {
	generate_random_user
	sleep 1 # 给系统一点点时间完成文件 IO

	local init_cfg=" "
	local conf_file="/var/etc/$NAME.toml"

	> "$conf_file"
	config_load "$NAME"

	local stdout stderr user group respawn env conf_inc
	uci_validate_section "$NAME" init "$init_cfg" \
		'stdout:bool:1' \
		'stderr:bool:1' \
		'user:string' \
		'group:string' \
		'respawn:bool:1' \
		'env:list(string)' \
		'conf_inc:list(string)'

	local err=$?
	[ $err -ne 0 ] && {
		_err "uci_validate_section returned $err"
		return 1
	}

	[ -n "$conf_inc" ] && config_list_foreach "$init_cfg" conf_inc cat >> "$conf_file"

	procd_open_instance
	procd_set_param command "$PROG" -c "$conf_file"
	procd_set_param file $conf_file
	procd_set_param stdout $stdout
	procd_set_param stderr $stderr
	[ -n "$user" ] && procd_set_param user "$user"
	[ -n "$group" ] && procd_set_param group "$group"
	[ $respawn -eq 1 ] && procd_set_param respawn
	[ -n "$env" ] && config_list_foreach "$init_cfg" env "procd_append_param env"
	procd_close_instance
}
