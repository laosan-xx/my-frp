#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

NAME=frps
PROG=/usr/bin/$NAME

_err() {
	echo "$*" >&2
	logger -p daemon.err -t "$NAME" "$*"
}

# Format value for TOML output (quote strings, leave numbers/booleans bare)
toml_value() {
	local val="$1"
	case "$val" in
		true|false) printf '%s' "$val" ;;
		*[!0-9-]*) printf '"%s"' "$val" ;;
		*) printf '%s' "$val" ;;
	esac
}

# Map old INI-style keys to new TOML keys for server
map_server_key() {
	case "$1" in
		bind_port)            echo "bindPort" ;;
		bind_addr)            echo "bindAddr" ;;
		kcp_bind_port)        echo "kcpBindPort" ;;
		quic_bind_port)       echo "quicBindPort" ;;
		proxy_bind_addr)      echo "proxyBindAddr" ;;
		vhost_http_port)      echo "vhostHTTPPort" ;;
		vhost_https_port)     echo "vhostHTTPSPort" ;;
		vhost_http_timeout)   echo "vhostHTTPTimeout" ;;
		tcpmux_http_connect_port) echo "tcpmuxHTTPConnectPort" ;;
		dashboard_addr)       echo "webServer.addr" ;;
		dashboard_port)       echo "webServer.port" ;;
		dashboard_user)       echo "webServer.user" ;;
		dashboard_pwd)        echo "webServer.password" ;;
		token)                echo "auth.token" ;;
		auth_method)          echo "auth.method" ;;
		max_pool_count)       echo "transport.maxPoolCount" ;;
		tcp_mux)              echo "transport.tcpMux" ;;
		heartbeat_timeout)    echo "transport.heartbeatTimeout" ;;
		tls_force)            echo "transport.tls.force" ;;
		subdomain_host)       echo "subDomainHost" ;;
		max_ports_per_client) echo "maxPortsPerClient" ;;
		udp_packet_size)      echo "udpPacketSize" ;;
		user_conn_timeout)    echo "userConnTimeout" ;;
		detailed_errors_to_client) echo "detailedErrorsToClient" ;;
		*)                    echo "$1" ;;
	esac
}

config_cb() {
	[ $# -eq 0 ] && return

	local type="$1"
	local name="$2"
	if [ "$type" = "conf" ]; then
		# Server config: all options are top-level TOML keys
		option_cb() {
			local option="$1"
			local value="$2"
			local key=$(map_server_key "$option")
			echo "$key = $(toml_value "$value")" >> "$conf_file"
		}
		list_cb() {
			local name="$1"
			local value="$2"
			[ "$name" = "_" ] && echo "$value" >> "$conf_file"
		}
	else
		[ "$type" = "init" ] && init_cfg="$name"
		option_cb() { return 0; }
		list_cb() { return 0; }
	fi
}

service_triggers()
{
	procd_add_reload_trigger "$NAME"
}

start_service() {
	local init_cfg=" "
	local conf_file="/var/etc/$NAME.toml"

	> "$conf_file"
	config_load "$NAME"

	local stdout stderr user group respawn env conf_inc
	uci_validate_section "$NAME" init "$init_cfg" \
		'stdout:bool:1' \
		'stderr:bool:1' \
		'user:string' \
		'group:string' \
		'respawn:bool:1' \
		'env:list(string)' \
		'conf_inc:list(string)'

	local err=$?
	[ $err -ne 0 ] && {
		_err "uci_validate_section returned $err"
		return 1
	}

	[ -n "$conf_inc" ] && config_list_foreach "$init_cfg" conf_inc cat >> "$conf_file"

	procd_open_instance
	procd_set_param command "$PROG" -c "$conf_file"
	procd_set_param file $conf_file
	procd_set_param stdout $stdout
	procd_set_param stderr $stderr
	[ -n "$user" ] && procd_set_param user "$user"
	[ -n "$group" ] && procd_set_param group "$group"
	[ $respawn -eq 1 ] && procd_set_param respawn
	[ -n "$env" ] && config_list_foreach "$init_cfg" env "procd_append_param env"
	procd_close_instance
}
